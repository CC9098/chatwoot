#!/usr/bin/env bash

set -euo pipefail

bundle exec rails ip_lookup:setup

if [[ "${RAILWAY_RUN_SIDEKIQ_IN_WEB:-false}" == "true" ]]; then
  bundle exec sidekiq -C config/sidekiq.yml &
  sidekiq_pid=$!

  cleanup() {
    kill "$sidekiq_pid" 2>/dev/null || true
  }

  trap cleanup EXIT INT TERM
fi

exec bin/rails server -p "${PORT:-3000}" -e "${RAILS_ENV:-production}"
